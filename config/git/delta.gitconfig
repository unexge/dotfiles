; Delta config - used by magit-delta and CLI git
; Pairs with the ayu-dark Pi theme.

[delta]
	syntax-theme = ayu-dark
	plus-style = syntax "#1c2923"
	plus-emph-style = syntax "#283f2b"
	plus-non-emph-style = syntax "#1c2923"
	minus-style = syntax "#2b1f27"
	minus-emph-style = syntax "#492a33"
	minus-non-emph-style = syntax "#2b1f27"
