; Delta config - used by magit-delta and CLI git
; Pairs with the ayu-dark Pi theme.

[delta]
	syntax-theme = ayu-dark
	plus-style = normal "#1c2923"
	plus-emph-style = normal "#283f2b"
	plus-non-emph-style = normal "#1c2923"
	minus-style = normal "#2b1f27"
	minus-emph-style = normal "#492a33"
	minus-non-emph-style = normal "#2b1f27"
