command = nu --login -c "zellij attach -c"
shell-integration = nushell
env = PATH=/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin

window-save-state = always
quit-after-last-window-closed = true
macos-option-as-alt = true

font-family = Fira Code Medium
font-size = 16
font-thicken = true
window-padding-x = 0
window-padding-y = 0
window-width = 80
window-height = 20
theme = Ayu
palette = 0=#11151c
palette = 1=#f07178
palette = 2=#aad94c
palette = 3=#e6b450
palette = 4=#59c2ff
palette = 5=#d2a6ff
palette = 6=#95e6cb
palette = 7=#bfbdb6
palette = 8=#5a6673
palette = 9=#f07178
palette = 10=#aad94c
palette = 11=#e6b450
palette = 12=#59c2ff
palette = 13=#d2a6ff
palette = 14=#95e6cb
palette = 15=#bfbdb6

# Clear screen on `cmd+k`
keybind = cmd+k=text:\x0c

keybind = alt+backspace=text:\x1b\x7f
keybind = alt+right=text:\x1b[1;3C
keybind = shift+enter=text:\n
